{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "<worker-name>",
  "compatibility_date": "<YYYY-MM-DD>",
  // The Worker only runs for the paths in run_worker_first. Every other
  // request is a static asset, which stays free and unlimited.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Example binding. With no database_id, Wrangler creates the database on
  // first deploy and keeps it linked. Delete if not needed.
  // "d1_databases": [{ "binding": "DB", "database_name": "<worker-name>-db" }],
  "observability": { "enabled": true }
}
